# Nothing in this directory is meant to be requested by a browser: PHP files
# here are only included by index.php/api.php (or run from the CLI), and
# modules/ holds the operator's config.php and its backups.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
